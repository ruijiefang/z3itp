(declare-fun s0 () Int)
(declare-fun f (Int) Int)
(declare-fun s1 () Int)
(declare-fun a1 () Int)
(declare-fun a0 () Int)
(declare-fun a2 () Int)
(declare-fun s2 () Int)
(declare-fun b2 () Int)
(declare-fun b0 () Int)
(declare-fun fb (Int) Int)
(declare-fun b1 () Int)
