(declare-fun a0 () Int)
(declare-fun fa (Int) Int)
(declare-fun a2 () Int)
(declare-fun s2 () Int)
(declare-fun a1 () Int)
(declare-fun s0 () Int)
(declare-fun s1 () Int)
(declare-fun b0 () Int)
(declare-fun f (Int) Int)
(declare-fun b2 () Int)
(declare-fun fb (Int) Int)
(declare-fun b1 () Int)
(assert (= s2 (+ s0 2)))
(assert (>= (f b0) (+ b0 2)))
(assert (or (>= (fb s2) (+ b2 2)) (distinct (fb b1) b2)))
(assert (or (distinct (fb s1) b1) (>= (f s1) (+ s2 0))))
(assert (or (>= (fb b1) (+ b1 1)) (distinct (f b2) s1)))
(assert (= b1 (+ s1 1)))
