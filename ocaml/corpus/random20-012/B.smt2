(assert (distinct (f s1) s1))
(assert (= (f b0) (+ b0 1)))
(assert (<= b2 (+ b0 1)))
(assert (distinct (f b2) b0))
(assert (or (<= (f b2) (+ s1 0)) (distinct b0 s1)))
(assert (or (>= b2 (+ b2 1)) (>= (f s2) (+ b2 (- 2)))))
