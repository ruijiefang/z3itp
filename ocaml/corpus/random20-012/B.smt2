(declare-fun a2 () Int)
(declare-fun f (Int) Int)
(declare-fun s2 () Int)
(declare-fun s1 () Int)
(declare-fun fa (Int) Int)
(declare-fun s0 () Int)
(declare-fun a0 () Int)
(declare-fun a1 () Int)
(declare-fun b0 () Int)
(declare-fun fb (Int) Int)
(declare-fun b2 () Int)
(declare-fun b1 () Int)
(assert (or (distinct (f b0) s2) (>= (f b0) (+ s0 2))))
(assert (or (distinct b0 b2) (>= (fb b0) (+ b0 (- 1)))))
(assert (= s1 (+ b1 2)))
(assert (or (= (fb s1) (+ s2 2)) (<= b1 (+ b2 2))))
