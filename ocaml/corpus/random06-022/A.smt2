(declare-fun s1 () Int)
(declare-fun f (Int) Int)
(declare-fun s0 () Int)
(declare-fun s2 () Int)
(declare-fun a1 () Int)
(declare-fun fa (Int) Int)
(declare-fun a0 () Int)
(declare-fun a2 () Int)
(declare-fun b2 () Int)
(declare-fun b0 () Int)
(declare-fun b1 () Int)
(declare-fun fb (Int) Int)
(assert (>= (f s0) (+ s1 (- 2))))
(assert (= s0 (+ s2 0)))
(assert (distinct (fa a0) a1))
(assert (>= (f a1) (+ s0 (- 1))))
(assert (or (= (fa s1) (+ a1 1)) (>= a2 (+ s2 1))))
(assert (or (distinct (fa a2) a0) (<= (fa a0) (+ s0 (- 2)))))
