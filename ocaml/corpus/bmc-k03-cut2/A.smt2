(declare-fun i0 () Int)
(declare-fun s0 () Int)
(declare-fun i1 () Int)
(declare-fun mem1 () (Array Int Int))
(declare-fun s1 () Int)
(declare-fun h (Int) Int)
(declare-fun mem0 () (Array Int Int))
(declare-fun i2 () Int)
(declare-fun mem2 () (Array Int Int))
(declare-fun s2 () Int)
(declare-fun i3 () Int)
(declare-fun mem3 () (Array Int Int))
(declare-fun s3 () Int)
(assert (= i0 0))
(assert (= s0 0))
(assert (and (= mem1 (store mem0 i0 (h i0)))
     (= s1 (+ s0 (select mem1 i0)))
     (= i1 (+ i0 1))))
(assert (and (= mem2 (store mem1 i1 (h i1)))
     (= s2 (+ s1 (select mem2 i1)))
     (= i2 (+ i1 1))))
(assert (forall ((X Int)) (>= (h X) 0)))
