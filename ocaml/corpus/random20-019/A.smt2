(declare-fun a1 () Int)
(declare-fun s1 () Int)
(declare-fun f (Int) Int)
(declare-fun s0 () Int)
(declare-fun s2 () Int)
(declare-fun a0 () Int)
(declare-fun fa (Int) Int)
(declare-fun a2 () Int)
(declare-fun b0 () Int)
(declare-fun b2 () Int)
(declare-fun b1 () Int)
(declare-fun fb (Int) Int)
(assert (<= a1 (+ a1 2)))
(assert (distinct (f s0) s1))
(assert (or (distinct s0 s2) (= a1 (+ s1 0))))
(assert (distinct a0 s2))
(assert (<= (fa a1) (+ a1 1)))
(assert (= (f s2) (+ s0 2)))
(assert (>= a2 (+ s0 2)))
(assert (= (f s2) (+ s1 0)))
