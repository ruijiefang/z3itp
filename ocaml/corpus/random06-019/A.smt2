(declare-fun s1 () Int)
(declare-fun s0 () Int)
(declare-fun a1 () Int)
(declare-fun a0 () Int)
(declare-fun s2 () Int)
(declare-fun f (Int) Int)
(declare-fun a2 () Int)
(declare-fun fa (Int) Int)
(declare-fun b1 () Int)
(declare-fun b2 () Int)
(declare-fun fb (Int) Int)
(assert (= s0 (+ s1 0)))
(assert (distinct a0 a1))
(assert (or (= (f s1) (+ a0 (- 1))) (<= (f s2) (+ s2 2))))
(assert (or (>= (fa s1) (+ s0 (- 2))) (<= a2 (+ s2 (- 1)))))
(assert (or (= (f s1) (+ a1 2)) (= (fa a0) (+ s2 0))))
(assert (or (<= s2 (+ s1 1)) (= (fa a2) (+ s1 (- 2)))))
