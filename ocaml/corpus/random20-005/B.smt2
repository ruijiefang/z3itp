(declare-fun a1 () Int)
(declare-fun fa (Int) Int)
(declare-fun a0 () Int)
(declare-fun a2 () Int)
(declare-fun f (Int) Int)
(declare-fun s1 () Int)
(declare-fun s0 () Int)
(declare-fun s2 () Int)
(declare-fun b0 () Int)
(declare-fun fb (Int) Int)
(declare-fun b1 () Int)
(declare-fun b2 () Int)
(assert (>= (f b0) (+ s2 1)))
(assert (or (<= (fb s1) (+ s0 (- 1))) (distinct (fb s1) s2)))
(assert (distinct s2 s0))
(assert (or (>= b0 (+ b0 (- 1))) (distinct (f b1) s0)))
(assert (or (<= (fb s0) (+ b1 0)) (<= (f b1) (+ b2 0))))
(assert (distinct (fb s1) s2))
(assert (or (= (f b1) (+ b1 0)) (>= s2 (+ s2 2))))
(assert (or (distinct s2 s1) (distinct b2 s1)))
(assert (distinct s1 s0))
(assert (= (f b2) (+ s0 (- 1))))
(assert (= b0 (+ b2 (- 2))))
(assert (= (fb b2) (+ b1 0)))
(assert (or (<= (f s0) (+ b2 2)) (>= b2 (+ b0 (- 2)))))
(assert (distinct (fb s2) b1))
(assert (or (distinct (f b1) b2) (= (f s2) (+ s1 2))))
(assert (or (= (f b1) (+ s0 0)) (= (f s2) (+ b1 1))))
(assert (= (fb b2) (+ s1 2)))
(assert (or (= (fb b0) (+ b2 0)) (>= (fb s2) (+ s2 (- 1)))))
(assert (or (>= (fb s2) (+ b1 0)) (<= (fb b2) (+ b2 1))))
(assert (distinct (f s1) s2))
