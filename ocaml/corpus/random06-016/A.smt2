(declare-fun s0 () Int)
(declare-fun f (Int) Int)
(declare-fun s1 () Int)
(declare-fun a0 () Int)
(declare-fun a1 () Int)
(declare-fun a2 () Int)
(declare-fun s2 () Int)
(declare-fun fa (Int) Int)
(declare-fun b1 () Int)
(declare-fun b0 () Int)
(declare-fun fb (Int) Int)
(assert (= (f s1) (+ s0 0)))
(assert (= (f a1) (+ a0 2)))
(assert (or (<= a2 (+ s0 (- 1))) (>= (f s1) (+ a2 (- 1)))))
(assert (or (= s2 (+ a2 2)) (>= s0 (+ a1 1))))
(assert (= (f s2) (+ s2 0)))
(assert (or (distinct (fa s1) a0) (= (fa a2) (+ a1 0))))
