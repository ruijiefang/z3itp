(declare-fun s1 () Int)
(declare-fun s2 () Int)
(declare-fun fa (Int) Int)
(declare-fun a1 () Int)
(declare-fun a2 () Int)
(declare-fun s0 () Int)
(declare-fun a0 () Int)
(declare-fun f (Int) Int)
(declare-fun b1 () Int)
(declare-fun fb (Int) Int)
(declare-fun b2 () Int)
(declare-fun b0 () Int)
(assert (or (>= (f s2) (+ s2 1)) (<= (f b1) (+ s2 0))))
(assert (or (<= (fb b2) (+ b1 (- 2))) (>= (f s1) (+ s1 (- 2)))))
(assert (>= (fb s0) (+ b0 (- 2))))
(assert (= s2 (+ s1 0)))
(assert (or (= (fb s0) (+ s1 1)) (= (f s0) (+ s1 (- 2)))))
(assert (or (distinct (fb b0) s1) (>= (fb b2) (+ s0 2))))
